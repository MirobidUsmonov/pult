<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ekranni uzatish uchun: xizmat oldingi planda ishlashi shart,
         aks holda Android uni o'chirib qo'yadi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ekran o'chganda tizim protsessorni to'xtatadi va Wi-Fi ni
         uxlatadi - ulanish uziladi. Bu ruxsatlar uzatish davomida
         qulf olib turish uchun. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Batareya tejash ilovani ekran o'chgach o'ldiradi. Bu ruxsat
         foydalanuvchidan istisno so'rash imkonini beradi - qaror
         baribir uniki. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/PultTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".HostsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Kompyuterdagi ulash sahifasidagi QR kod shu ko'rinishda
                 bo'ladi: telefon kamerasi bilan skanerlansa ilova ochiladi -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pult" />
            </intent-filter>
            <!-- Telegramga kelgan tunnel havolasi. Tunnel manzili
                 kompyuter har qayta yonganda o'zgaradi, shuning uchun
                 uni ilovaga qo'lda ko'chirish o'rniga havolani bosish
                 kifoya: Android "Pult bilan ochish" ni taklif qiladi
                 va ilova manzilni o'zi yangilaydi.

                 Domen bizniki emas, shuning uchun autoVerify yo'q -
                 Android tanlov oynasini ko'rsatadi. Bu to'g'ri: hamma
                 trycloudflare havolalarini ushlab olish noto'g'ri
                 bo'lardi. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*.trycloudflare.com" />
            </intent-filter>
            <!-- Havolani "Ulashish" orqali yuborish ham ishlaydi: bu
                 har qanday tunnel yoki domen uchun yagona umumiy yo'l. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Ekranni uzatuvchi xizmat. mediaProjection turi majburiy:
             Android 14 dan boshlab usiz ekran olishga ruxsat berilmaydi. -->
        <service
            android:name=".ScreenService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Kiritish xizmati. Foydalanuvchi uni sozlamalardan qo'lda
             yoqadi - bu Android himoyasi, chetlab o'tib bo'lmaydi. -->
        <service
            android:name=".InputService"
            android:exported="true"
            android:label="Pult — telefonni boshqarish"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>

        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density" />
    </application>
</manifest>
