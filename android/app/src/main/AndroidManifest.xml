<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- For screen sharing: the service has to run in the foreground,
         or Android shuts it down -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- With the screen off the system stops the CPU and puts Wi-Fi to
         sleep, and the connection drops. These permissions let us hold
         a lock while sharing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Battery saving kills the app once the screen is off. This
         permission lets us ask the user for an exemption - the decision
         stays theirs. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Dictation: the page records a few seconds of speech and the
         computer turns it into text. The audio goes to that computer
         and nowhere else. A phone without a microphone is fine - the
         button simply does not appear. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/PultTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".HostsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The QR code on the computer's pairing page has this
                 shape: scanned with the phone camera it opens the app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pult" />
            </intent-filter>
            <!-- The tunnel link that arrives in Telegram. The tunnel
                 address changes every time the computer restarts, so
                 rather than copying it into the app by hand, tapping the
                 link is enough: Android offers "Open with Pult" and the
                 app updates the address itself.

                 The domain is not ours, so there is no autoVerify -
                 Android shows a chooser. That is right: grabbing every
                 trycloudflare link would be wrong. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*.trycloudflare.com" />
            </intent-filter>
            <!-- Sending the link through "Share" works too: it is the
                 one route that fits any tunnel or domain. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The screen-sharing service. The mediaProjection type is
             mandatory: from Android 14 on, capture is refused without
             it. -->
        <service
            android:name=".ScreenService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- The input service. The user turns it on by hand in the
             settings - that is an Android protection and cannot be
             worked around. -->
        <service
            android:name=".InputService"
            android:exported="true"
            android:label="Pult — control this phone"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>

        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density" />
    </application>
</manifest>
